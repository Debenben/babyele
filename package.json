{
  "name": "babyele",
  "version": "0.8.8",
  "description": "program to control lego walker",
  "main": ".webpack/main",
  "scripts": {
    "configure": "sudo setcap cap_net_raw+eip ./node_modules/electron/dist/electron && sudo bash -c 'chown root:root $(pwd)/node_modules/electron/dist/chrome-sandbox && chmod 4755 $(pwd)/node_modules/electron/dist/chrome-sandbox'",
    "start": "electron-forge start",
    "test": "electron-forge start -- -- --simulation ",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "author": "bene",
  "license": "ISC",
  "dependencies": {
    "@stoprocent/bluetooth-hci-socket": "^2.3.0",
    "babylonjs": "^9.2.0",
    "babylonjs-gui": "^9.2.0",
    "babylonjs-loaders": "^9.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "node-poweredup": "^10.1.0",
    "node-addon-api": "8.7.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vercel/webpack-asset-relocator-loader": "^1.10.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "electron": "^43.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "node-loader": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
